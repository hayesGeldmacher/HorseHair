      propertyPath: dialogueText.alternativeDialogue.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[0].dialogue
      value: 'Thanks pal, you''ve been a real help lately. '
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[1].dialogue
      value: 'Could you do me one more favor? Would you go spend some time with your
        little brother? '
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: I dunno, I've had a long day. I just wanted to hang out by myself for
        a bit.
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: Just watch some TV, or a play a damn game with him.
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: Too much time alone isn't good for a young man, believe me...
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].dialogue
      value: Okay...
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[0].name
      value: Dad
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[1].name
      value: Me
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
