    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[0].dialogue
      value: Go spend some time with your brother.
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[1].dialogue
      value: 'Can I go watch TV now? '
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[2].dialogue
      value: Yeah. Thanks for being a team player tonight, buddy.
      objectReference: {fileID: 0}
