      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].sound
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[0].dialogue
      value: Heya pal, I went and got stuck in the darn walls again!
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[1].dialogue
      value: 'Can you do me a quick favor? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: 'I left Jesse''s plush under my bed - can you take a look for me? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: 'What are you talking about? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: '...Look, I''m really to upset to move. Will you be a pal and clean
        up the birdie? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].dialogue
      value: I guess...
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].dialogue
      value: 'No, that kid is always running around - why don''t you get to it? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[0].name
      value: Dad
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[1].name
      value: Dad
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[2].name
      value: Dad
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[3].name
      value: Dad
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
