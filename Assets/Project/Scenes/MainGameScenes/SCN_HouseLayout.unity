    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: I'm sorry to scare ya pal, but to be honest, things are pretty scary
        right now.
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: 'I don''t know if your brother realizes it yet. '
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: Go watch TV with him for a bit - I'll be talking to him later.
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[0].name
