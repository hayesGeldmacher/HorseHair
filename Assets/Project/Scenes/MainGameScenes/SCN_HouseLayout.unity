      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].sound
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[7].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[0].dialogue
      value: You said you needed some-
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[1].dialogue
      value: Glad you're here buddy, I could use an extra hand.
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: I'm on the phone with our insurance, but there's a damn mouse in the
        walls, and it's driving me crazy!
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: Can you grab me a mousetrap? Should be one in the downstairs bathroom.
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: '...oh, and some cheese. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].dialogue
      value: 'I guess - did you see the mouse in Jesse''s room this morning? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].dialogue
      value: 'Oh... yeah. I picked up the little fella while you guys were at school. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[7].dialogue
      value: 'Well, get on with it, why don''t ya? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[0].name
      value: Me
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[1].name
      value: Dad
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[2].name
      value: Me
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[1].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[2].sound
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[0].dialogue
      value: Jesse was really quiet during dinner...
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[1].dialogue
      value: Jay! Get up here, I need your help!
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[2].dialogue
      value: I should go see what Dad wants in his room.
      objectReference: {fileID: 0}
    - target: {fileID: 1528422079501264313, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: m_Enabled
