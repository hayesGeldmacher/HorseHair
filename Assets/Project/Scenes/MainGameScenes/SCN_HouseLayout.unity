      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[10].sound
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.alternativeDialogue.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[0].dialogue
      value: 'Everything alright this morning? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[1].dialogue
      value: 'I''m fine... '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: You don't usually read the milk carton for minutes on end.
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: 'I''m fine. A mouse just died in my room last night, kinda freaked me
        out. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: You're really scared of a little mouse?
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].dialogue
      value: 'It died right by my backpack, and it just - I didn''t like it. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].dialogue
      value: 'If I go grab your backpack for you, will you stop moping around? '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[7].dialogue
      value: I'm not moping. But, yeah - please.
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[8].dialogue
      value: 'Uhh yeah, I guess - but you better get your ass to school after. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[9].dialogue
      value: 'Uhh yeah, I guess - but you better get your ass to school after. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
