      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
      propertyPath: CompletedDialogue.dialogue.Array.data[0].dialogue
      value: 'Alright... bye, Dad. '
      objectReference: {fileID: 0}
    - target: {fileID: 8491677008935539016, guid: ea8b1146c61dc2b4ab769c34be1bb6ee, type: 3}
