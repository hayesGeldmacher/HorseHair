      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[2].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[3].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[4].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[0].dialogue
      value: Heya, pal! I chased that mouse all the way to his little hiding spot.
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[1].dialogue
      value: 'I''m behind the walls, and wouldn''t ya know it, I must''ve tripped
        the breaker. '
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[2].dialogue
      value: 'Can you come give your old man a hand? '
      objectReference: {fileID: 0}
