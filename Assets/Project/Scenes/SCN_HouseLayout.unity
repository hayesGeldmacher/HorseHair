    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[0].dialogue
      value: Damn its early
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: task.ThoughtText.dialogue.Array.data[1].dialogue
      value: I wonder if Jesse is up yet
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
