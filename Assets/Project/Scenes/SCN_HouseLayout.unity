    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[0].dialogue
      value: Yo Jes! Wake up
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[1].dialogue
      value: ... morning
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: I'm going to eat, you want something?
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: Do we have the Corn-Os?
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: How about you get up and check
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].dialogue
      value: I'm not dressed yet
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].dialogue
      value: Fine, I'll look, but you're making breakfast tomorrow, and I like my
        eggs over easy
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[7].dialogue
      value: But I don't know how to cook eggs
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[8].dialogue
      value: Better learn today then
      objectReference: {fileID: 0}
    - target: {fileID: 966868564021206957, guid: 1d237f6ce9410a847812f7e5ab034948, type: 3}
