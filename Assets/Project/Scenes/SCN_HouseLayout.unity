    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].sound
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[0].dialogue
      value: Jay, my man. Your dad gonna let you out of the house this weekend?
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[1].dialogue
      value: Might just sneak out. Need to figure out what to do with Jes first
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[2].dialogue
      value: C'mon man, I don't wanna baby sit, just send him to the park or something
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[3].dialogue
      value: He's not "that" young but I'll think about it
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[4].dialogue
      value: Quiet in the back... thank you
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[5].dialogue
      value: Hey I'm home, dinner smells good
      objectReference: {fileID: 0}
    - target: {fileID: 361243124172791228, guid: 03308a7cf8b3e9c4ba4a98db353d32d9, type: 3}
      propertyPath: dialogueText.dialogue.Array.data[6].dialogue
      value: Whatever you say pal
      objectReference: {fileID: 0}
